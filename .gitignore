# ---- ISim simulation outputs ----
*.wdb
*.wcfg
isim.log
isim.wdb
fuse.log
fuse.xmsgs
*.exe
*.vcd

# ---- CORE Generator (keep only .xco and .coe sources) ----
coregen.cgp
coregen.cgc
ipcore_dir/*
!ipcore_dir/*.xco
!ipcore_dir/*.coe
*.asy
*.gise
*.veo
*.vho
*.sym

# ---- ModelSim / Questa ----
transcript
vsim.wlf
modelsim.ini
*.mpf
*.mti

# ---- MATLAB ----
*.asv
*.autosave
slprj/
*.mex*
*.mat

# ---- Generated simulation / result data ----
# Un-comment next line to keep the dump out of git
# filtered_output.txt

# ---- OS / editor files ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/

# ---- Keep these important files (override rules above) ----
!*.v
!*.vhd
!*.ucf
!*.xco
!*.coe
!*.xise
!*.m
!*.md
!docs/**
!docs/images/*.png

